# ============================================================================
# Lawdger — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit secrets.
# ============================================================================

# ---- Auth (required) ----
# NextAuth v5 session signing secret. Generate via:
#   openssl rand -base64 32
AUTH_SECRET=

# ---- Database (required) ----
# Both URLs use the SAME database password.
# Reset at: Supabase Dashboard → Settings → Database → Database password
# Avoid '@' in passwords (URL parser breaks). If unavoidable, URL-encode as %40.
# Avoid smart/curly quotes when copy-pasting.

# Pooled connection — app runtime queries (transaction mode, port 6543).
# Format:
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<HOST>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# Direct connection — Prisma migrations (session mode, port 5432).
# On IPv4-only networks the direct host (db.<PROJECT_REF>.supabase.co:5432)
# is unreachable. Use the session-mode pooler instead:
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<HOST>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# ---- LLM (required for chat + voice features) ----
# Google Gemini API key — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ---- LLM provider config (optional — defaults shown) ----
LLM_PROVIDER=gemini
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b
