# ============================================================================
# Lawdger — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit secrets.
# ============================================================================

# ---- Auth (required) ----
# NextAuth v5 session signing secret. Generate via:
#   openssl rand -base64 32
AUTH_SECRET=

# ---- Database (required) ----
# Both URLs use the SAME database password.
# Reset at: Supabase Dashboard → Settings → Database → Database password
# Avoid '@' in passwords (URL parser breaks). If unavoidable, URL-encode as %40.
# Avoid smart/curly quotes when copy-pasting.

# Pooled connection — app runtime queries (transaction mode, port 6543).
# Format:
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<HOST>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
# connection_limit >= 5 is REQUIRED. The scoped-Prisma RLS extension wraps
# each op in its own transaction (set_config + query), and Next.js server
# actions can serve multiple concurrent requests against the same Prisma
# instance. connection_limit=1 deadlocks under any concurrency and surfaces
# as Prisma P2024 ("Timed out fetching a new connection"). See
# src/lib/prisma-rls.ts for the architecture rationale.
DATABASE_URL=

# Direct connection — Prisma migrations (session mode, port 5432).
# On IPv4-only networks the direct host (db.<PROJECT_REF>.supabase.co:5432)
# is unreachable. Use the session-mode pooler instead:
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<HOST>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# ---- LLM (required for chat + voice features) ----
# Google Gemini API key — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ---- LLM provider config (optional — defaults shown) ----
LLM_PROVIDER=gemini
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b

# ---- DIRECT_URL note (Lawdger ops reality, 2026-06-13) ----
# Both DATABASE_URL and DIRECT_URL point to the transaction pooler
# (port 6543) on this project. The Supabase direct connection
# (db.<ref>.supabase.co:5432) is IPv6-only and unreachable from
# Sahil's network. The session pooler (port 5432) was not adopted
# to avoid env churn after the 6543 setup was confirmed working.
#
# Consequence: `prisma migrate resolve/deploy/status` HANGS against
# this DIRECT_URL. Documented operational workaround for marking a
# manually-applied migration as resolved:
#
#   Insert directly into _prisma_migrations via Supabase MCP
#   execute_sql or the Supabase SQL editor. Same row shape as
#   `prisma migrate resolve --applied` produces:
#     - id: gen_random_uuid()
#     - checksum: sha256 of migration.sql
#     - migration_name: <timestamp>_<name>
#     - logs: NULL
#     - rolled_back_at: NULL
#     - started_at + finished_at: NOW()
#     - applied_steps_count: 0
#
# Vercel build step uses `prisma generate` (no DIRECT_URL needed)
# and does NOT run `prisma migrate deploy` automatically — schema
# changes are applied manually via Supabase SQL editor per the
# 3.2.5a / 3.0.1a / 3.0.1b pattern. So the hang has no production
# impact.
