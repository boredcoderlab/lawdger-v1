{
  "name": "lawdger-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && NODE_OPTIONS='--max-old-space-size=8192' next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "prisma": "dotenv -e .env.local -- prisma",
    "smoke": "npm run smoke:tsc && npm run smoke:prisma && npm run smoke:rls && npm run smoke:rls-runtime",
    "smoke:tsc": "tsc --noEmit",
    "smoke:prisma": "dotenv -e .env.local -- prisma validate",
    "smoke:rls": "dotenv -e .env.local -- tsx scripts/check-rls.ts",
    "smoke:rls-runtime": "dotenv -e .env.local -- tsx scripts/check-rls-runtime.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "openai": "^6.36.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
