generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CaseStatus {
  ACTIVE
  CLOSED
}

enum MatterType {
  LITIGATION
  ADVISORY
  PRE_LITIGATION
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  name           String?
  password       String?
  preferences    String? // Stored as JSON string for now
  cases          Case[]
  notes          Note[]
  tasks          Task[]
  calendarEvents CalendarEvent[]
  payments       Payment[]
  documents      Document[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Case {
  id         String     @id @default(uuid())
  userId     String
  title      String
  clientName String?
  agreedFee  Float?
  status     CaseStatus @default(ACTIVE)

  // Path B additive fields — Case Registry expansion
  court           String?
  caseNumber      String?
  caseType        String? // CIVIL | CRIMINAL | WRIT | APPEAL | COMMERCIAL | FAMILY | ARBITRATION | OTHER
  matterType      MatterType @default(LITIGATION)
  nextHearingDate DateTime?
  description     String?

  // Phase 2a additive — litigation metadata
  filingDate    DateTime?
  actsSections  String?
  firNumber     String?
  policeStation String?

  user           User            @relation(fields: [userId], references: [id])
  notes          Note[]
  tasks          Task[]
  calendarEvents CalendarEvent[]
  payments       Payment[]
  documents      Document[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

model Note {
  id            String    @id @default(uuid())
  caseId        String
  userId        String
  rawTranscript String?
  cleanContent  String
  category      String // Client Update, Next Date, Task, General Note
  nextDate      DateTime?
  case          Case      @relation(fields: [caseId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Task {
  id          String    @id @default(uuid())
  caseId      String
  userId      String
  description String
  status      String    @default("pending") // pending, completed
  assignee    String    @default("Unassigned")
  dueDate     DateTime?
  isUrgent    Boolean   @default(false)
  case        Case      @relation(fields: [caseId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CalendarEvent {
  id          String   @id @default(uuid())
  caseId      String
  userId      String
  title       String
  hearingDate DateTime
  description String?
  noteId      String?  @unique
  case        Case     @relation(fields: [caseId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id        String    @id @default(uuid())
  caseId    String
  userId    String
  amount    Float
  status    String    @default("pending") // pending, paid
  dueDate   DateTime?
  case      Case      @relation(fields: [caseId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Document {
  id         String   @id @default(uuid())
  userId     String
  caseId     String?
  filename   String
  storageKey String?
  size       Int?
  mimeType   String?
  status     String   @default("unsorted") // unsorted, sorted
  user       User     @relation(fields: [userId], references: [id])
  case       Case?    @relation(fields: [caseId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([caseId])
}
